# Server
PORT=4100
SESSION_SECRET=change-me-to-a-long-random-string
COOKER_URL=http://localhost:5174
MERCHANT_URL=http://localhost:5175

# BSC Testnet
CHAIN_ID=97
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
