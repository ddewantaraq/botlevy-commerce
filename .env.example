# Server
PORT=4100
SESSION_SECRET=change-me-to-a-long-random-string
# Local defaults. On Railway use HTTPS origins (dummy until real Vercel URLs):
# COOKER_URL=https://botlevy-cooker.vercel.app
# MERCHANT_URL=https://botlevy-merchant.vercel.app
COOKER_URL=http://localhost:5174
MERCHANT_URL=http://localhost:5175

# BSC Testnet
CHAIN_ID=97
BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
MOCK_USDC_ADDRESS=

# Ollama Cloud (required for LLM plan_recipe; fallback recipe used if missing/fails)
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3.5
# Log LLM input/output + persist on AgentStep (1/true)
LLM_TRACE=

# Demo script payer (optional — never commit real keys)
DEMO_PAYER_PRIVATE_KEY=

# x402 public runs (Track E) — POST /agent/public/runs
X402_ENABLED=false
# Agent treasury (matches ERC-8004 agentWallet on bsc-testnet)
X402_PAYTO=0x9389afdD7Ae5729BcCD2DFeac738b8bFd6110a74
# Atomic MockUSDC (6 decimals). 10000 = 0.01 mUSDC
X402_PRICE=10000

# Frontend (Vite)
VITE_API_URL=http://localhost:4100
VITE_CHAIN_ID=97
VITE_MOCK_USDC_ADDRESS=
VITE_BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Expand Agent steps with args/result/llm I/O in cooker UI
VITE_AGENT_DEBUG=

# ERC-8004 (Track D) — Botlevy CommerceAgent on bsc-testnet
ERC8004_AGENT_ID=2464
ERC8004_AGENT_URI=https://botlevy-commerce-production.up.railway.app/agent/metadata.json?v=2
ERC8004_TX_HASH=0x350420cccafd878e289b6aa1e6dd83f97250e32fde38dc714a8b13d350fed758
